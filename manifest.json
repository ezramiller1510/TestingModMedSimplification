{
  "manifest_version": 3,
  "name": "ModMed Protocol Automator",
  "version": "1.1",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://rep.modmedapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://rep.modmedapp.com/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://rep.modmedapp.com/*"],
      "js": ["content.js"]
    }
  ]
}